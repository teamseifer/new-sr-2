# Mangofy (gateway de PIX)
MANGOFY_API_KEY=
MANGOFY_STORE_CODE=
MANGOFY_BASE_URL=https://checkout.mangofy.com.br
MANGOFY_PIX_PATH=/api/v1/payment

# Dominio publico do site (usado na postback_url)
SITE_BASE_URL=

# Gateway ativo
GATEWAY_PROVIDER=mangofy

# UTMify (vendas no dashboard). Coloque tambem como secret das Pages.
UTMIFY_API_TOKEN=
UTMIFY_API_URL=https://api.utmify.com.br/api-credentials/orders
UTMIFY_PLATFORM=Mangofy

# Supabase (comprovantes PIX — so no servidor; nunca no front-end)
# Projeto Sim-velani (mesmo do SUPER-SIM-GENESYS), bucket/tabela isolados.
SUPABASE_URL=https://uoqjytsfgjovdntmgqne.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=comprovantes-sr
SUPABASE_TABLE=comprovantes_sr
